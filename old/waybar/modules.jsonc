{
    "sway/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": {  },
        "format-icons": {
            "active": "󰮯",
            "persistent": "",
            "empty": ""
         }
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "persistent-workspaces": { "*": 5 },
        "format-icons": {
            "active": "󰮯",
            "persistent": "",
            "empty": ""
         }
    },
    "mpris": {
        "format": "{artist} - {title}",
        "tooltip-format" : "{album}",
        "format-paused": " {artist} - {title}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next",
        "max-length": 45
    },
    "sway/window": {
        "max-length": 45,
    },
    "hyprland/window": {
        "max-length": 45,
    },
    "network": {
        "interval": 10,
        "format-disabled": "",
        "format-disconnected": "",
        "format-wifi": "",
        "format-ethernet": "",
        "tooltip-format": "{essid}\n\nFrequency: {frequency}GHz\nStrength: {signalStrength}%\n\n{bandwidthUpBytes}   {bandwidthDownBytes}",
        "menu": "on-click-right",
        "menu-file": "~/.config/waybar/context/network.xml",
        "menu-actions": {
  			"action-1": "nmcli radio wifi off",
  			"action-2": "nmcli radio wifi on",
            "action-3": "hyprctl dispatch exec '[float] alacritty -e nmtui'",
            "action-4": "hyprctl dispatch exec nm-connection-editor"
  		}
    },
    "bluetooth": {
        "format": "{}",
        "format-on": "",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "{device_alias}",
        "format-connected-battery": "{device_alias}",
        "tooltip-format": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}   {device_battery_percentage}%",
        "on-click": "~/.local/bin/toggle_bluetooth &",
        "on-click-right": "hyprctl dispatch exec blueman-manager"
    },
    "tray": {
        "icon-size": 20,
        "show-passive-items": true,
        "spacing": 4,
    },
    "cpu": {
        "format": " {usage}%",
        "on-click": "hyprctl dispatch exec '[float]alacritty -T \"Task Manager\" --class btop -e btop'",
        "cursor": false,
    },
    "memory": {
        "interval": 30,
        "format": "\uefc5 {used:0.1f}G/{total:0.1f}G",
        "on-click": "hyprctl dispatch exec '[float]alacritty -T \"Task Manager\" --class btop -e btop'",
        "cursor": false,
    },
    "battery": {
        "interval": 20,
        "full-at": 100,
        "tooltip": true,
        "format-full": "",
        "format": "{icon} {capacity}%",
        "format-time": "{H}:{M:02}",
        "format-charging": "󰂄 {capacity}% ({time})",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "clock": {
        "timezone": "Europe/Vilnius",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B %d}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#ffffff'><b>{}</b></span>",
                "weekdays": "<span color='#fc5f72'><b>{}</b></span>",
                "today": "<span color='#fc5f72'><b><u>{}</u></b></span>"
            }
        },
        "cursor": false
    },
    "custom/notifications": {
        "tooltip": true,
        "format": "<span size='14pt'>󰣇</span>",
        // "format-icons": {
        //     "notification": "󱅫",
        //     "none": "󰂜",
        //     "dnd-notification": "󰂠",
        //     "dnd-none": "󰪓",
        //     "inhibited-notification": "󰂛",
        //     "inhibited-none": "󰪑",
        //     "dnd-inhibited-notification": "󰂛",
        //     "dnd-inhibited-none": "󰪑"
        // },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
